# STEP3 over-distillation pipeline (Snakemake 7).  prompts -> on-policy rollouts (sharded GPU jobs) -> teacher checkpoints ->
# LoRA training per arm -> MATH-500 last-300 (lockstep @1024, 3 shards) -> guards (GSM8K / HumanEval+ / IFEval, official harnesses) -> table.
# Job names use arm.lower(): Kubernetes rejects capitals (yqin-i1-s3train-smoke-M failed with a bare "Error encountered", 2026-10-15).
# Snakemake runs on the login node and only ORCHESTRATES: every GPU step is a RunAI job submitted through modules/submit_wait.sh
# (H200 x 0.51, the standing pool rule), which polls until the job finishes and checks the expected output. Rules are idempotent, so
# `snakemake -j 8` can be re-run after a failure and continues where it stopped.
#   cd idea1_selective_distill/code/step3/pipeline && PYTHONPATH=../../../../modules/pydeps snakemake -n            # dry run
#   PYTHONPATH=../../../../modules/pydeps snakemake -j 6 --keep-going first_wave                           # M + C2 on MATH only
#   PYTHONPATH=../../../../modules/pydeps snakemake -j 6 all                                               # every arm incl. guards
# See pipeline/README.md. Plan and reading rules: technical_details/step3_plan_frontier_kd.md.
import math, json
configfile: "config.yaml"

NI   = "/mnt/lts4/scratch/home/yqin/DllmAR/new_ideas"
I1   = f"{NI}/idea1_selective_distill"
MOD  = f"{NI}/modules"
OUT  = f"{I1}/outputs/step3"
CK   = f"{I1}/outputs/checkpoints"
LOGS = f"{I1}/outputs"
SW   = f"bash {MOD}/submit_wait.sh"
TAG  = config["tag"]                           # job-name suffix for this pipeline run, e.g. s3a
N_PROMPTS = config["n_prompts"]
N_SHARDS  = config["rollout_shards"]
SHARD = math.ceil(N_PROMPTS / N_SHARDS)
ARMS  = config["arms"]                         # name -> {teacher: beta|null, extra: "..."}
N_MATH = config.get("math_shards", 3)         # last 300 only (user rule 2026-10-12), split into N_MATH equal jobs
MATH_SHARDS = [(200 + k * (300 // N_MATH), 200 + (k + 1) * (300 // N_MATH)) for k in range(N_MATH)]
RUN = f"step3-{TAG}"                           # every trained checkpoint / eval log carries the pipeline tag (1k test vs 8k run never overwrite)

def teacher_ckpt(arm):
    b = ARMS[arm]["teacher"]
    return "none" if b is None else f"{CK}/add-a10-b{int(round(b * 10)):02d}"

def student_name(arm):
    return ARMS[arm].get("student", config["student"])

def student_ckpt(arm):
    return config["students"][student_name(arm)]

wildcard_constraints:
    arm="|".join(ARMS), i="[0-9]+", s="[0-9]+", st="|".join(config["students"])

rule all:
    input: f"{I1}/technical_details/step3_results_{TAG}.md"

rule first_wave:          # M + C2, MATH only (plan §3 budget rule)
    input: expand(f"{LOGS}/step3/{RUN}-{{arm}}/math500/free-last300-merged/summary.json", arm=config["first_wave"])

# ---------- data ----------
rule prompts:
    output: f"{OUT}/prompts.jsonl"
    shell: "export PYTHONPATH=; systemd-run --user --scope -p MemoryMax=4G -p MemorySwapMax=0 -q "
           "bash -c 'source {MOD}/jobenv.sh mdlm-math-b300 && python {I1}/code/step3/build_prompts.py --out {output}'"

# on-policy: every student init decodes the prompts itself (rollouts/<student>/); an arm trains on its own student's rollouts only
rule rollout_shard:
    input: f"{OUT}/prompts.jsonl"
    output: f"{OUT}/rollouts/{{st}}/s{{i}}/rollouts.jsonl"
    params: start=lambda w: int(w.i) * SHARD, end=lambda w: min(N_PROMPTS, (int(w.i) + 1) * SHARD), batch=config["rollout_batch"],
            model=lambda w: config["students"][w.st]
    shell: "{SW} yqin-i1-s3roll-{wildcards.st}-{wildcards.i}-{TAG}-h200f051 {output} "
           "bash {MOD}/run_step3_rollout.sh {OUT}/rollouts/{wildcards.st}/s{wildcards.i} {params.start} {params.end} {params.batch} {params.model}"

rule rollouts_merged:
    input: expand(f"{OUT}/rollouts/{{{{st}}}}/s{{i}}/rollouts.jsonl", i=range(N_SHARDS))
    output: f"{OUT}/rollouts/{{st}}/all.jsonl"
    shell: "cat {input} > {output} && wc -l {output}"

# ---------- teachers (addition line A(beta) = D_b + tau_D + beta*tau_A; built once, flock-serialised inside the runner) ----------
rule teacher:
    output: f"{CK}/add-a10-b{{bb}}/merge_manifest.json"
    params: beta=lambda w: int(w.bb) / 10
    shell: "{SW} yqin-i1-s3build-b{wildcards.bb}-{TAG}-h200f051 {output} "
           "bash {MOD}/run_build_addition.sh {CK}/add-a10-b{wildcards.bb} 1.0 {params.beta}"

# ---------- training ----------
rule train:   # C4 = ARMS[arm].extra carries --corruption random; C1 drops the anchor; the runner only maps arm -> trainer flags listed in config
    input:
        roll=lambda w: f"{OUT}/rollouts/{student_name(w.arm)}/all.jsonl",
        teacher=lambda w: [] if ARMS[w.arm]["teacher"] is None else f"{teacher_ckpt(w.arm)}/merge_manifest.json"
    output: f"{CK}/{RUN}-{{arm}}/merged/config.json"
    params: jn=lambda w: w.arm.lower(), teacher=lambda w: teacher_ckpt(w.arm), student=lambda w: student_ckpt(w.arm), extra=lambda w: ARMS[w.arm].get("extra", ""), common=config["train_args"]
    shell: "{SW} yqin-i1-s3train-{params.jn}-{TAG}-h200f051 {output} "
           "bash {MOD}/run_step3_train.sh {wildcards.arm} {CK}/{RUN}-{wildcards.arm} {params.teacher} {params.student} {input.roll} {params.common} {params.extra}"

# ---------- MATH-500 last 300, lockstep @1024, student alone (1x), 3 shards ----------
rule eval_math_shard:
    input: f"{CK}/{RUN}-{{arm}}/merged/config.json"
    output: directory(f"{LOGS}/step3/{RUN}-{{arm}}/math500/free-last300-s{{s}}")
    params: jn=lambda w: w.arm.lower(), start=lambda w: MATH_SHARDS[int(w.s)][0], end=lambda w: MATH_SHARDS[int(w.s)][1]
    shell: "{SW} yqin-i1-s3m500-{params.jn}-s{wildcards.s}-{TAG}-h200f051 {output}/run.log "
           "bash {MOD}/run_gated_shard5.sh {LOGS}/step3/{RUN}-{wildcards.arm}/math500 {CK}/{RUN}-{wildcards.arm}/merged none free "
           "{params.start} {params.end} free-last300-s{wildcards.s} 0"

rule eval_math_merge:
    input: expand(f"{LOGS}/step3/{RUN}-{{{{arm}}}}/math500/free-last300-s{{s}}", s=range(N_MATH))
    output: f"{LOGS}/step3/{RUN}-{{arm}}/math500/free-last300-merged/summary.json"
    shell: "export PYTHONPATH=; source {MOD}/jobenv.sh mdlm-math-b300 && python {I1}/code/step3/merge_math_shards.py --shards {input} --out $(dirname {output})"

# ---------- guards: official harnesses from dream_study (zsh wrappers; labels keyed by arm) ----------
DS_EVAL = "/mnt/lts4/scratch/home/yqin/DllmAR/dream_study/step2_instruct/scripts/eval"
rule eval_ifeval:
    input: f"{CK}/{RUN}-{{arm}}/merged/config.json"
    output: f"{LOGS}/step3/{RUN}-{{arm}}/ifeval.done"
    params: jn=lambda w: w.arm.lower()
    shell: "{SW} yqin-i1-s3ifeval-{params.jn}-{TAG}-h200f051 {output} "
           "bash {MOD}/run_official_eval.sh ifeval {CK}/{RUN}-{wildcards.arm}/merged {RUN}-{wildcards.arm} {output}"

rule eval_humaneval:
    input: f"{CK}/{RUN}-{{arm}}/merged/config.json"
    output: f"{LOGS}/step3/{RUN}-{{arm}}/humaneval.done"
    params: jn=lambda w: w.arm.lower()
    shell: "{SW} yqin-i1-s3heval-{params.jn}-{TAG}-h200f051 {output} "
           "bash {MOD}/run_official_eval.sh coding {CK}/{RUN}-{wildcards.arm}/merged {RUN}-{wildcards.arm} {output}"

rule eval_gsm8k:
    input: f"{CK}/{RUN}-{{arm}}/merged/config.json"
    output: f"{LOGS}/step3/{RUN}-{{arm}}/gsm8k.done"
    params: jn=lambda w: w.arm.lower()
    shell: "{SW} yqin-i1-s3gsm8k-{params.jn}-{TAG}-h200f051 {output} "
           "bash {MOD}/run_official_eval.sh gsm8k {CK}/{RUN}-{wildcards.arm}/merged {RUN}-{wildcards.arm} {output}"

rule results_table:
    input:
        math=expand(f"{LOGS}/step3/{RUN}-{{arm}}/math500/free-last300-merged/summary.json", arm=ARMS),
        guards=expand(f"{LOGS}/step3/{RUN}-{{arm}}/{{g}}.done", arm=config["guard_arms"], g=["ifeval", "humaneval", "gsm8k"])
    output: f"{I1}/technical_details/step3_results_{TAG}.md"
    shell: "export PYTHONPATH=; source {MOD}/jobenv.sh mdlm-math-b300 && python {I1}/code/step3/results_table.py --logs {LOGS} --run {RUN} --arms {' '.join(ARMS)} --out {output}"
